PORT=3001
MONGODB_URI=mongodb://localhost:27017/quiz_champ
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h
SESSION_JWT_SECRET=your-session-jwt-secret-here
FRONTEND_URL=http://localhost:3000

# SMS API (Used for OTP and notifications - fallback if WhatsApp fails)
SMS_PROVIDER=api
SMS_API_URL=https://your-sms-api.com/send
SMS_API_KEY=your-sms-api-key

# WhatsApp API (Primary messaging channel with SMS fallback)
WHATSAPP_PROVIDER=api
WHATSAPP_API_URL=https://your-whatsapp-api.com/send
WHATSAPP_API_KEY=your-whatsapp-api-key
# Set to 'mock' for development to skip actual API calls

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Quiz Champ 2026 <noreply@satyalok.in>

# AWS S3 (or S3-compatible storage: MinIO, DigitalOcean Spaces, etc.)
AWS_REGION=ap-south-1
AWS_STORAGE_ENDPOINT=          # optional — leave blank for real AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=quiz-champ-files

# Payment Gateway (PhonePe via Satyalok PGS)
PAYMENT_PROVIDER=phonepe
PGS_BASE_URL=http://localhost:5002
PGS_API_KEY=your-shared-api-key-here
# Callback URL registered with PGS (must be publicly accessible)
# QCB_CALLBACK_URL=https://your-quiz-champ-backend.com/api/payment/callback

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@satyalok.in
