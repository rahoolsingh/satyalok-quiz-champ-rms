PORT=3001
MONGODB_URI=mongodb://localhost:27017/quiz_champ
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# 2Factor SMS API
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=your-2factor-api-key

# AWS S3 (or S3-compatible storage: MinIO, DigitalOcean Spaces, etc.)
AWS_REGION=ap-south-1
AWS_STORAGE_ENDPOINT=          # optional — leave blank for real AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=quiz-champ-files

# Payment Gateway (Razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@quizchamp.com
