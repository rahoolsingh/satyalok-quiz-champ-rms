PORT=3001
MONGODB_URI=mongodb://localhost:27017/quiz_champ
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000

# 2Factor SMS API
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=your-2factor-api-key

# AWS S3 (or S3-compatible storage: MinIO, DigitalOcean Spaces, etc.)
AWS_REGION=ap-south-1
AWS_STORAGE_ENDPOINT=          # optional — leave blank for real AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=quiz-champ-files

# Payment Gateway (PhonePe via Satyalok PGS)
PAYMENT_PROVIDER=phonepe
PGS_BASE_URL=https://your-payment-gateway-url.com
PGS_API_KEY=your-shared-api-key-here
# Callback URL registered with PGS (must be publicly accessible)
# QCB_CALLBACK_URL=https://your-quiz-champ-backend.com/api/payment/callback

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@quizchamp.com
