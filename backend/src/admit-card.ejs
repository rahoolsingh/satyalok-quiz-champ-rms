<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= admitCardType %> - Quiz Champ <%= competitionYear %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght=400;500;600;700&display=swap');
        html, body {
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Poppins', sans-serif;
            display: flex;
            justify-content: center;
        }
        .a4-container {
            width: 210mm;
            height: 297mm;
            min-width: 210mm;
            max-width: 210mm;
            min-height: 297mm;
            max-height: 297mm;
            background-color: #ffffff;
            box-sizing: border-box;
            padding: 10mm 15mm 8mm 15mm;
            position: relative;
            overflow: hidden;
        }
        @media print {
            .a4-container {
                padding: 8mm 12mm 6mm 12mm;
                margin: 0;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="bg-gray-100 py-4 print:py-0 print:bg-white">

    <div class="a4-container flex flex-col justify-between shadow-2xl print:shadow-none">
        
        <div>
            <div class="flex items-start justify-between gap-4 mb-4">
                <div class="w-20 h-20 flex-shrink-0 flex items-center justify-center">
                    <img src="https://static.wixstatic.com/media/45b05b_dc00b7f9cc114db7830d9d4730d51310~mv2.png/v1/fill/w_524,h_162,al_c,lg_1,q_85,enc_avif,quality_auto/Satyalok%20Latest%20Logo%202023.png" 
                         alt="Satyalok Logo" class="w-full h-full object-contain">
                </div>

                <div class="text-center flex-1">
                    <h1 class="text-2xl font-bold text-gray-900 tracking-wide"><%= organizationName %></h1>
                    <p class="text-xs font-semibold text-blue-600 mt-0.5 uppercase tracking-wider">Quiz Champ <%= competitionYear %> Competition</p>
                    
                    <h2 class="text-base font-bold text-gray-950 mt-3 border border-black inline-block px-5 py-1 rounded bg-yellow-50">
                        <%= admitCardType %>
                    </h2>
                </div>

                <div class="w-24 h-24 border-2 border-blue-600 p-1 bg-white flex flex-col items-center justify-center flex-shrink-0 rounded shadow-sm">
                    <div class="w-20 h-20 bg-gray-50 border border-dashed border-gray-400 flex items-center justify-center text-[10px] text-gray-400 font-bold text-center leading-none overflow-hidden">
                        <% if (locals.systemQrCode) { %>
                            <img src="<%= systemQrCode %>" alt="System QR" class="w-full h-full object-cover">
                        <% } else { %>
                            QR CODE
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="w-full border-t border-l border-blue-500 grid grid-cols-12 mb-3 text-xs">
                
                <div class="col-span-3 border-r border-b border-blue-500 bg-blue-50 p-2 text-center flex flex-col justify-center font-bold text-gray-800">
                    <span>Date & Time of Exam</span>
                </div>
                <div class="col-span-9 border-r border-b border-blue-500 p-2 bg-white font-bold text-gray-900 flex items-center gap-3">
                    <span class="text-red-600 text-[15px]"><%= examDate %></span>
                    <span class="text-gray-300">|</span>
                    <span class="text-gray-700 text-[11px]">Reporting: <%= reportingTime %></span>
                    <span class="text-gray-300">|</span>
                    <span class="text-gray-700 text-[11px]">Exam: <%= examTime %></span>
                </div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-gray-50 p-2.5 font-semibold text-gray-700">Roll Number</div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2.5 bg-white font-bold text-blue-700 tracking-wide text-sm"><%= rollNumber %></div>

                <!-- Photo: spans 4 rows -->
                <div class="col-span-4 row-span-4 border-r border-b border-blue-500 p-2 bg-white flex flex-col items-center justify-center">
                    <div class="w-full h-full border border-gray-300 rounded bg-gray-50/50 flex items-center justify-center text-center text-[10px] text-gray-400 font-medium border-dashed overflow-hidden min-h-[110px]">
                        <% if (locals.candidatePhotoUrl) { %>
                            <img src="<%= candidatePhotoUrl %>" alt="Candidate Photo" class="w-full h-full object-cover rounded">
                        <% } else { %>
                            [ Photo ]
                        <% } %>
                    </div>
                </div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-gray-50 p-2.5 font-semibold text-gray-700">Candidate Name</div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2.5 bg-white font-bold text-gray-900 uppercase"><%= candidateName %></div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-gray-50 p-2.5 font-semibold text-gray-700">Class</div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2.5 bg-white font-semibold text-gray-800"><%= studentClass %></div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-gray-50 p-2.5 font-semibold text-gray-700">Batch Category</div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2.5 bg-white font-medium text-gray-800"><%= batchCategory %></div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-gray-50 p-2.5 font-semibold text-gray-700">Guardian Name</div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2.5 bg-white font-medium text-gray-800"><%= guardianName %></div>

                <!-- Map QR: spans 3 rows -->
                <div class="col-span-4 row-span-3 border-r border-b border-blue-500 p-2 bg-gray-50 flex flex-col items-center justify-center text-center">
                    <div class="w-20 h-20 bg-white border border-gray-300 flex items-center justify-center text-[10px] text-gray-400 font-bold font-mono leading-none mb-1 shadow-sm overflow-hidden">
                        <% if (locals.mapQrCode) { %>
                            <img src="<%= mapQrCode %>" alt="Map QR" class="w-full h-full object-cover">
                        <% } else { %>
                            MAP QR
                        <% } %>
                    </div>
                    <span class="text-[8px] font-bold text-gray-700 uppercase tracking-tighter">Scan Location</span>
                </div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-gray-50 p-2.5 font-semibold text-gray-700">Mobile Number</div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2.5 bg-white font-medium text-gray-800"><%= mobileNumber %></div>

                <div class="col-span-3 border-r border-b border-blue-500 bg-blue-50 p-2 font-bold text-gray-800 flex flex-col justify-center text-[11px]">
                    <span>EXAMINATION CENTRE</span>
                </div>
                <div class="col-span-5 border-r border-b border-blue-500 p-2 bg-white font-bold text-gray-900 flex items-center leading-relaxed text-[11px]">
                    <%= centreDetails %>
                </div>
            </div>

            <div class="p-2.5 border border-gray-300 rounded bg-gray-50/50">
                <h3 class="text-[11px] font-bold text-gray-900 uppercase tracking-wider mb-1 border-b pb-0.5 text-blue-800">Important Instructions</h3>
                <ul class="space-y-0.5 text-[10px] text-gray-700 font-medium list-disc list-inside px-0.5">
                    <li>The candidate must carry this printed admit card and a valid school ID.</li>
                    <li>Report to the venue strictly 30 minutes prior to the examination time.</li>
                    <li>Use only <span class="font-bold text-blue-700">Blue/Black</span> ballpoint pen. Pencils are strictly prohibited.</li>
                    <li>Electronic devices and calculators are not allowed inside the hall.</li>
                    <li>Hand over the bottom tear-off section to the invigilator with the OMR.</li>
                </ul>
            </div>

            <div class="grid grid-cols-3 gap-6 pt-5 text-center text-[11px] font-bold text-gray-800">
                <div class="flex flex-col justify-end items-center">
                    <div class="w-28 border-b border-gray-400 mb-1 h-4"></div>
                    <span class="text-gray-500 font-medium text-[9px]">Candidate's Signature</span>
                </div>
                <div class="flex flex-col justify-end items-center">
                    <div class="w-28 border-b border-gray-400 mb-1 h-4"></div>
                    <span class="text-gray-500 font-medium text-[9px]">Invigilator's Signature</span>
                </div>
                <div class="flex flex-col justify-end items-center">
                    <div class="w-28 border-b border-gray-400 mb-1 h-4"></div>
                    <span class="text-blue-800 text-[9px]">Authorized Signatory</span>
                </div>
            </div>
        </div>

        <div>
            <div class="pt-1 border-t border-dashed border-gray-300 text-[9px] text-gray-400 font-mono flex justify-between mb-2">
                <span>Generated: <%= generatedDate %></span>
                <span>ID: <%= systemId %></span>
            </div>

            <div class="relative my-2">
                <div class="absolute inset-0 flex items-center" aria-hidden="true">
                    <div class="w-full border-t border-dashed border-gray-400"></div>
                </div>
                <div class="relative flex justify-center text-[8px] font-bold uppercase tracking-wider text-gray-400">
                    <span class="bg-white px-2 border border-gray-300 rounded-full py-0.5">&#9986; Tear here. Staple with OMR sheet. &#9986;</span>
                </div>
            </div>

            <div class="border border-black p-2.5 rounded bg-gray-50/30">
                <div class="flex justify-between items-center border-b pb-1 mb-2">
                    <h4 class="text-xs font-bold text-gray-900 tracking-wide uppercase">OFFICE COPY / OMR SLIP</h4>
                    <span class="text-[10px] font-mono font-bold text-blue-700 bg-white px-2 py-0.5 border rounded">Roll No: <%= rollNumber %></span>
                </div>
                
                <div class="grid grid-cols-12 gap-2 text-[11px] font-semibold text-gray-800 items-stretch">
                    <div class="col-span-3">
                        <span class="text-gray-400 block text-[9px] uppercase font-bold">Candidate</span>
                        <span class="text-xs font-bold text-gray-900 uppercase"><%= candidateName %></span>
                    </div>
                    <div class="col-span-2">
                        <span class="text-gray-400 block text-[9px] uppercase font-bold">Class</span>
                        <span class="text-xs font-bold text-gray-900"><%= studentClass %> (<%= batchType %>)</span>
                    </div>
                    <div class="col-span-3 flex flex-col justify-end items-center border-l border-r px-1">
                        <div class="w-full border-b border-gray-300 h-5 mb-0.5"></div>
                        <span class="text-[7px] text-gray-500 font-bold uppercase tracking-tight text-center leading-tight mt-0.5">Invigilator Sign & Stamp</span>
                    </div>
                    
                    <div class="col-span-4 flex items-center justify-center bg-white p-1 border-2 border-red-500 rounded shadow-sm">
                        <div class="bg-gray-50 flex items-center justify-center overflow-hidden" style="width:200px;height:200px;">
                            <% if (locals.omrQrCode) { %>
                                <img src="<%= omrQrCode %>" alt="OMR Scanner QR" style="width:200px;height:200px;" class="object-contain">
                            <% } else { %>
                                <span class="text-[9px] text-gray-500 font-bold font-mono">SCAN OMR</span>
                            <% } %>
                        </div>
                    </div>
                </div>
                <p class="text-[7px] font-black text-red-600 mt-1 uppercase tracking-tight text-right">&#9888; Checker Use Only — Do Not Damage QR</p>
            </div>
        </div>

    </div>
</body>
</html>
